DATABASE_URL=./immune-td.db
BIND_HOST=0.0.0.0
BIND_PORT=3100
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TOKEN_TTL_DAYS=30
ANON_RETENTION_DAYS=30
BODY_LIMIT_KB=500
LOG_LEVEL=info
# 首次启动自动创建 admin（users 空 + 两者都有值时）
# INITIAL_ADMIN_USERNAME=larry
# INITIAL_ADMIN_PASSWORD=change-me

# 微信小游戏（M-WX 路径用）
# 来自微信公众平台 → 开发管理 → 开发设置
# AppSecret 只在 server 端用（调 jscode2session），不要泄漏给客户端
WECHAT_APPID=
WECHAT_APPSECRET=
