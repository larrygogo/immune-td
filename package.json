{
  "name": "immune-td",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Larry <351220018@qq.com>",
  "copyright": "Copyright (c) 2026 Larry. All Rights Reserved.",
  "type": "module",
  "workspaces": ["packages/*", "apps/*", "server"],
  "scripts": {
    "dev": "bun scripts/subset-font.ts && vite --config apps/h5/vite.config.ts",
    "dev:all": "bun scripts/dev-all.ts",
    "dev:server": "cd server && bun run dev",
    "prebuild": "bun scripts/subset-font.ts",
    "build": "tsc --noEmit && vite build --config apps/h5/vite.config.ts",
    "subset-font": "bun scripts/subset-font.ts",
    "preview": "vite preview --config apps/h5/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check apps packages tests",
    "format": "biome format --write apps packages tests",
    "play": "vite --config packages/core/examples/playground/vite.config.ts",
    "balance": "bun scripts/balance.ts",
    "baseline": "bun scripts/baseline.ts",
    "wx:login": "bash apps/wx/scripts/wx-login.sh",
    "wx:preview": "bun apps/wx/scripts/wx-preview.ts",
    "wx:preview:legacy": "bash apps/wx/scripts/wx-preview.sh",
    "build:wx": "vite build -c apps/wx/vite.config.ts && bun apps/wx/postbuild.ts"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "phaser": "3.90",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.23.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/howler": "^2.2.12",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "miniprogram-ci": "^2.1.31",
    "sharp": "^0.34.5",
    "subset-font": "^2.5.0",
    "terser": "^5.46.1",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
